{
  "name": "the-trading-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx drizzle/migrate.ts",
    "db:reset": "tsx drizzle/seed/reset.ts && pnpm db:migrate && pnpm db:seed",
    "db:seed": "tsx drizzle/seed/index.ts",
    "db:studio": "drizzle-kit studio",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "stripe:listen": "stripe listen --forward-to localhost:5173/api/webhooks/stripe",
    "stripe:sync": "tsx drizzle/seed/stripe-sync.ts",
    "ci": "pnpm lint && pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^1.10.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.9",
    "@neondatabase/serverless": "^1.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@react-email/render": "^2.0.7",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/blob": "^2.3.3",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "resend": "^6.12.2",
    "stripe": "^22.1.0",
    "sveltekit-superforms": "^2.30.1",
    "valibot": "^1.3.1"
  }
}
